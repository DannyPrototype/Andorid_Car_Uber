<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarRadio" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/speed_normal</item>
        <item name="colorPrimaryContainer">@color/bg_card</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/mode_uber_passenger</item>
        <item name="colorSurface">@color/bg_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_panel</item>
        <item name="android:windowKeepScreenOn">true</item>
    </style>

    <!-- Data card style -->
    <style name="DataCardText.Value">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="DataCardText.Unit">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="DataCardText.Label">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Bottom bar button style -->
    <style name="BottomBarButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
